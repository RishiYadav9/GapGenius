# GapGenius Environment Configuration
PORT=5000
NODE_ENV=development

# Ollama Local AI Configuration (Default local provider)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
AI_PROVIDER=ollama

# MongoDB Atlas Connection String (Optional - falls back to Local Session Vault if omitted)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gapgenius?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=gapgenius

# Google Gemini API Key (Alternative Cloud AI provider)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
